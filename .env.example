# Server port (default: 3000)
PORT=3000

# Allowed CORS origin for the client (default: allow all)
# CLIENT_URL=https://your-frontend-domain.com

# Public URL shown in QR codes and join links (default: window.location.origin)
# VITE_PUBLIC_URL=https://your-frontend-domain.com

# WebSocket server URL for the client (default: same origin via proxy)
# VITE_SOCKET_URL=https://your-backend-domain.com
